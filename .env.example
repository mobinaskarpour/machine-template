# Copy to .env and fill locally. Never commit real secrets.
# Rotate any token that was shared in chat, email, or screenshots.

TELEGRAM_BOT_TOKEN=

# Absolute or relative paths (resolved from process cwd)
DATA_ROOT=./data
PROJECTS_ROOT=./data/projects

LOG_LEVEL=info
NODE_ENV=development

# Phase 1 discovery
DISCOVERY_SEARCH_PROVIDER=
TAVILY_API_KEY=
SERPER_API_KEY=
DISCOVERY_MAX_SEARCH_RESULTS=8
DISCOVERY_MAX_PAGES=10
DISCOVERY_FETCH_TIMEOUT_MS=15000
DISCOVERY_MAX_PAGE_BYTES=1500000
DISCOVERY_MAX_TOTAL_TEXT_CHARS=120000
DISCOVERY_MIN_READY_CONFIDENCE=0.65
DISCOVERY_SYNTHESIS_PROVIDER=auto

# Optional Codex synthesis (defaults to CLI authenticated model when set to codex)
CODEX_MODEL=
CODEX_DISCOVERY_TIMEOUT_MS=180000

# Phase 6 deployment / operations (names only — never commit real values)
TELEGRAM_ADMIN_IDS=
DEMO_AUTO_DEPLOY=false
DEPLOYMENT_PORT_MIN=3100
DEPLOYMENT_PORT_MAX=3999
DEPLOYMENT_BIND_ADDRESS=127.0.0.1
DEPLOYMENT_PUBLIC_ENABLED=false
DEPLOYMENT_BASE_DOMAIN=
DEPLOYMENT_DOMAIN_PATTERN=
DEPLOYMENT_ACCEPT_NEXT_HIGH_LOOPBACK=true
NGINX_CONFIG_ROOT=
SSL_PROVIDER=
CERTBOT_EMAIL=
