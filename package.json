{
  "name": "the-machine",
  "version": "0.1.0",
  "private": true,
  "description": "THE MACHINE — Autonomous AI Company OS Builder (Phase 1 discovery)",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/app/main.ts",
    "start": "node dist/app/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bot": "tsx src/app/main.ts",
    "discover": "tsx src/app/discover-cli.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pino": "^9.7.0",
    "telegraf": "^4.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
